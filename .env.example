# Ключ OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Любая модель OpenRouter с поддержкой tool calling (проверь точный slug на openrouter.ai/models)
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017

# Голос (edge-tts): ru-RU-SvetlanaNeural или ru-RU-DmitryNeural
AIKO_VOICE=ru-RU-SvetlanaNeural
AIKO_PITCH=+30Hz
AIKO_RATE=+8%
