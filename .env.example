# Ключ OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Любая модель OpenRouter с поддержкой tool calling (проверь точный slug на openrouter.ai/models)
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017

# GitHub: задачи приватных репозиториев и больший лимит запросов (необязательно)
# GITHUB_TOKEN=

# Чат Twitch: Айко читает его (анонимно, без ключа) и отвечает зрителям (необязательно)
# TWITCH_CHANNEL=

# Голос (edge-tts): ru-RU-SvetlanaNeural или ru-RU-DmitryNeural
AIKO_VOICE=ru-RU-SvetlanaNeural
AIKO_PITCH=+30Hz
AIKO_RATE=+8%

# Распознавание речи (модель OpenRouter, которая понимает аудио)
AIKO_STT_MODEL=google/gemini-2.5-flash-lite
